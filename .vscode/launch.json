    "version": "0.2.0",
    "configurations": [
        {
            "name": "CLI - registry",
            "type": "go",
            "request": "launch",
            "mode": "debug",
            "program": "${workspaceFolder}/cmd/surp/main.go",
            "args": [
                "registry",
                "-l",
                "debug",
            ],
            "console": "integratedTerminal"
        },
        {
            "name": "CLI - provide",
            "type": "go",
            "request": "launch",
            "mode": "debug",
            "program": "${workspaceFolder}/cmd/surp/main.go",
            "args": [
                "provide",
                "-l",
                "debug",
                "test",
                "float64",
                "0.1",
                //"ro:true",
                "min:0",
                "max:100",
                "unit:percent",
                "description:Test float64 value",
            ],
            "env": {
                "SURP_REGISTRY": "localhost:5530",
            },
            "console": "integratedTerminal"
        }

    ]
}